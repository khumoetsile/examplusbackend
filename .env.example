PORT=3000
NODE_ENV=production
# Public URL of the portal (no trailing slash). Used for DPO redirect URLs.
APP_URL=https://exams.elevateskills.online
JWT_SECRET=change-me-to-a-long-random-string

# MySQL (same credentials you use for phpMyAdmin in cPanel)
DB_HOST=localhost
DB_USER=cpaneluser_exam
DB_PASSWORD=
DB_NAME=cpaneluser_exam

# First admin created by `npm run seed`
ADMIN_EMAIL=admin@elevateskills.online
ADMIN_PASSWORD=ChangeMe123!

# DPO Pay. Leave DPO_COMPANY_TOKEN empty to use the built-in MOCK gateway (testing only).
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
DPO_API_URL=https://secure.3gdirectpay.com/API/v6/
DPO_PAY_URL=https://secure.3gdirectpay.com/payv3.php
